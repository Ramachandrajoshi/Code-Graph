# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# The cgraph index, and the machine-wide cache if CGRAPH_HOME points here.
# Machine-specific absolute paths, rewritten constantly, and fully regenerable
# from source — committing it produces enormous diffs on every branch switch.
.cgraph/

# Build output
dist/
build/
out/
lib/
*.tsbuildinfo

# Test and coverage artifacts
coverage/
.nyc_output/
*.lcov
test-results/
junit.xml

# Benchmark scratch: clones of other repos used as benchmark targets
bench/repos/
bench/results/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# Environment and secrets.
# Embeddings read API keys from the environment; never let one reach a commit.
.env
.env.*
!.env.example
*.pem
*.key

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/mcp.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Agent configs are generated by `cgraph init` and are developer-specific.
# A contributor's local MCP registration should not land in the repo.
.mcp.json
.cursor/
.windsurf/
.aider*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Package manager artifacts we do not publish
*.tgz
.npm-packlist

# Temporary
tmp/
temp/
.cache/
*.tmp
